<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:id="@+id/w_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="0 day streak"
            android:textColor="#F2F2F0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1" />
        <TextView
            android:id="@+id/w_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="0/15 min"
            android:textColor="#B9B8B4"
            android:textSize="12sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/w_heat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:gravity="center_horizontal"
        android:letterSpacing="0.25"
        android:lineSpacingMultiplier="1.0"
        android:text="· · · · · · ·"
        android:textColor="#8B8A87"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/widget_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:gravity="center_horizontal"
        android:text="[··········]"
        android:textColor="#B9B8B4"
        android:textSize="12sp"
        android:maxLines="1" />
    <LinearLayout
        android:id="@+id/w_book"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">
        <ImageView
            android:id="@+id/w_cover"
            android:layout_width="42dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_book_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pick up where you left off"
                android:textColor="#F2F2F0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/w_book_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0% read"
                android:textColor="#B9B8B4"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/btn_continue"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_primary"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="▶"
            android:textColor="#111111"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btn_add"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="+ add"
            android:textColor="#F2F2F0"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/btn_scan"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="▣ scan"
            android:textColor="#F2F2F0"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/btn_stats"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="\@ streak"
            android:textColor="#F2F2F0"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
